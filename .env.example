# Copy to .env.local and fill in your own Firebase web app config
# (Firebase console > Project settings > Your apps > SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise (Google Cloud Fraud Defense) site key for your domain, used by App Check.
# It is public. Leave empty in local dev: the App Check debug provider is used on localhost instead.
VITE_RECAPTCHA_SITE_KEY=
